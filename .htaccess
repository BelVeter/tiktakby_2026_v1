<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On
    RewriteCond %{HTTP_REFERER} pfbaza.website [NC]
    RewriteRule .* – [F]

    RewriteEngine On
    RewriteCond %{HTTP_REFERER} gay-andrey.online [NC]
    RewriteRule .* – [F]

    RewriteEngine On
    RewriteCond %{HTTP:X-Forwarded-Proto} =http
    RewriteRule .* https://%{HTTP:Host}%{REQUEST_URI} [L,R=permanent]

    RewriteEngine On

    # Служебные файлы и каталоги проекта — 404. Корень сайта = корень проекта, и без этих
    # правил Apache отдавал любому .env, логи, дампы, доки (аудит 10.10.2026,
    # docs/security_audit_2026-10-10.md). Стоят ДО правила для bb/, чтобы действовать и там.
    # ⚠️ .zip/.rar и картинки nginx на проде отдаёт сам, мимо .htaccess — такие файлы
    # с чувствительным содержимым в репозиторий не класть вообще.
    RewriteRule ^\.well-known/ - [L]
    RewriteRule (^|/)\. - [R=404,L]
    RewriteRule ^(app|bootstrap|config|database|docker|docs|resources|routes|storage|tests|vendor|node_modules)(/|$) - [R=404,L]
    RewriteRule ^bb/logs/ - [R=404,L]
    RewriteRule \.(env|bak|old|orig|save|swp|sql|log|md|sh|py|lock|ya?ml|ini|dist|csv|cache)$ - [R=404,NC,L]
    RewriteRule (^|/)(error_log|artisan|phpunit\.xml|composer\.json|package(-lock)?\.json|webpack\.mix\.js|server\.php|log_auto\.txt)$ - [R=404,NC,L]

    RewriteRule ^bb(/|$) - [L]

    # Serve static image files directly — never route to Laravel
    RewriteRule \.(avif|webp|jpg|jpeg|png|gif|svg|ico|css|js|woff|woff2|ttf|eot)$ - [L]

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Canonical homepage is /ru (no trailing slash). Serve /ru directly to Laravel;
    # /ru/ falls through to the trailing-slash redirect below (301 -> /ru).
    # NOTE: requires the physical ~/public_html/ru directory to be absent, otherwise
    # mod_dir DirectorySlash would 301 /ru -> /ru/ before this rule runs.
    RewriteRule ^ru$ index.php [L,QSA]

    # Redirect Trailing Slashes If Not A Folder...
    # Emit an absolute https:// URL (not the bare path %1). TLS is terminated at the
    # proxy, so Apache sees the request as http and would otherwise rebuild the 301
    # Location with http:// — downgrading e.g. https://tiktak.by/ru/ -> http://tiktak.by/ru.
    # Same explicit-https technique as the X-Forwarded-Proto rule above.
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ https://%{HTTP:Host}%1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f

    RewriteRule ^ index.php [L]

    #RemoveHandler .html .htm

    <IfModule mod_mime.c>
        AddType image/avif .avif
        AddType image/webp .webp
    </IfModule>

    <IfModule mod_php.c>
        php_value date.timezone "Europe/Minsk"
    </IfModule>
    <IfModule mod_php7.c>
        php_value date.timezone "Europe/Minsk"
    </IfModule>
    <IfModule mod_php8.c>
        php_value date.timezone "Europe/Minsk"
    </IfModule>

</IfModule>

#AddType application/x-httpd-php .php .htm .html .phtml
#AddHandler php-cgi .php .htm .html .phtml

Options +ExecCGI
AddHandler application/x-httpd-lsphp .html .htm

<Files 403.shtml>
order allow,deny
allow from all
</Files>

