<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Служебные файлы — 404 (см. корневой .htaccess). Правила корня сюда не наследуются:
    # у public/ свой RewriteEngine On.
    RewriteRule (^|/)\. - [R=404,L]
    RewriteRule \.(env|bak|old|orig|save|swp|sql|log|md|sh|py|lock|ya?ml|ini|dist|csv|cache)$ - [R=404,NC,L]
    RewriteRule (^|/)error_log$ - [R=404,L]

    # Redirect www to non-www
    # %{REQUEST_URI}, а не $1: в этом .htaccess $1 считается от папки public/, и префикс /public
    # терялся — www.tiktak.by/public/x.jpg уводило на tiktak.by/x.jpg (404). Так ~300 раз в день
    # отваливался Googlebot-Image (ноябрь 2026). Query string R=301 переносит сам.
    RewriteCond %{HTTP_HOST} ^www\.(.*)$ [NC]
    RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Статика (картинки, css, js, шрифты) — никогда не в Laravel, как в корневом .htaccess.
    # Без этого отсутствующая картинка под /public/ запускала PHP + MySQL и отдавала HTML-страницу
    # 404 на 212 КБ (8 битых фото главной = +1.7 МБ на каждый первый заход, ноябрь 2026).
    # Проверено: ни один из 757 редиректов в таблице `redirects` не ведёт с адреса статики.
    RewriteRule \.(avif|webp|jpg|jpeg|png|gif|svg|ico|css|js|woff|woff2|ttf|eot)$ - [L]

    # Redirect Trailing Slashes If Not A Folder...
    # Emit absolute https:// URL so the 301 can't downgrade to http behind a TLS proxy.
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ https://%{HTTP:Host}%1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# Gzip Compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
</IfModule>

# Browser Caching
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/pdf "access plus 1 month"
    ExpiresByType text/x-javascript "access plus 1 month"
    ExpiresByType application/x-shockwave-flash "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresDefault "access plus 2 days"
</IfModule>
